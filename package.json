{
  "name": "yandex-gpt-writer",
  "version": "1.2.4",
  "description": "Клиент Yandex GPT / Speech / Art для Node.js (TypeScript)",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.js",
    "prepublishOnly": "npm test"
  },
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "yandex",
    "gpt",
    "yandexgpt",
    "llm",
    "nodejs",
    "api",
    "cloud",
    "tts",
    "stt"
  ],
  "author": "miwist",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miwist/yandex-gpt-writer"
  },
  "bugs": {
    "url": "https://github.com/Miwist/yandex-gpt-writer/issues"
  },
  "homepage": "https://github.com/Miwist/yandex-gpt-writer#readme",
  "devDependencies": {
    "typescript": "^5.9.3",
    "dotenv": "^17.2.3"
  }
}
